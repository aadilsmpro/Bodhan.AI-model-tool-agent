# Copy to .env and fill in. Never commit the real .env.

# --- Bodhan API keys (one per model, from https://console.bodhan.ai/) ---
BODHAN_BASE_URL=https://api.bodhan.ai/v1
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# --- Agent LLM (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=
# LLM_TIMEOUT_S=60

# --- Optional: Bodhan endpoint paths (defaults use the conventional v1 paths) ---
# BODHAN_TRANSCRIBE_ENDPOINT=/audio/transcriptions
# BODHAN_TRANSLATE_ENDPOINT=/chat/completions
# BODHAN_SPEAK_ENDPOINT=/audio/speech
# BODHAN_OCR_ENDPOINT=/chat/completions

# --- Optional: Bodhan client tuning (defaults shown) ---
# BODHAN_BASE_URL=https://api.bodhan.ai/v1
# BODHAN_MAX_CONCURRENCY=4        # simultaneous in-flight API calls
# BODHAN_MAX_RETRIES=4            # retries after the first attempt
# BODHAN_ATTEMPT_TIMEOUT_S=60     # per-attempt timeout
# BODHAN_TOTAL_TIMEOUT_S=180      # includes retries and time waiting for concurrency slots
# BODHAN_BACKOFF_BASE_S=1.0
# BODHAN_BACKOFF_CAP_S=20.0
# BODHAN_RETRY_AFTER_CAP_S=30.0

# --- Optional: cache and ledger ---
# BODHAN_CACHE_DIR=~/.cache/bodhan-tool-agent
# BODHAN_CACHE_REFRESH=0          # 1 = ignore existing entries once per process (debugging)
# BODHAN_LEDGER_PATH=             # if set, every charge is appended here as JSONL

# --- Optional: workspace sandbox for the MCP server ---
# BODHAN_WORKSPACE=.              # relative paths resolve here (default: current directory)
# BODHAN_OUT_DIR=./out            # artifacts go to <out>/artifacts, scratch to <out>/.scratch
# BODHAN_INPUT_DIRS=              # extra read-only roots, separated by ':' (';' on Windows)
# BODHAN_MAX_INPUT_MB=200
